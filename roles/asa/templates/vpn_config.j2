{##### Applies to Route-based VPNs ######}
object-group network {{ asa_vpn.local_grp }}
 description Local Networks accessible over VPN
{% for x in rmte_subnets %}
 network-object {{ x | ansible.utils.ipaddr('network') }} {{ x | ansible.utils.ipaddr('netmask') }}
{% endfor %}
!
object-group network {{ asa_vpn.az_vnet_grp }}
 description Remote Virtual network address spaces (supernets)
{% for y in az_vn_addr_spc %}
 network-object {{ y | ansible.utils.ipaddr('network') }} {{ y | ansible.utils.ipaddr('netmask') }}
{% endfor %}
!
object-group network {{ asa_vpn.az_subnet_grp }}
 description Remote Virtual subnets accessible over VPN
{% for y in az_subnets.values() %}
 network-object {{ y | ansible.utils.ipaddr('network') }} {{ y | ansible.utils.ipaddr('netmask') }}
{% endfor %}
!
access-list {{ asa_outside_acl }} extended permit ip object-group {{ asa_vpn.az_subnet_grp }} object-group {{ asa_vpn.local_grp }}
sysopt connection tcpmss 1350


{##### IKEv2 Ph1 and Ph2 parameters for Route-based VPNs ######}
crypto ikev2 enable {{ asa_vpn_interface }}
crypto ikev2 policy {{ asa_vpn_index }}
 encryption {{ p1_encr }}
 integrity {{ p1_hash }}
 prf {{ p1_hash | replace ("sha1","sha" ) }}
 group {{ dh }}
 lifetime seconds {{ p1_life }}
!
crypto ipsec ikev2 ipsec-proposal {{ cld_provider }}_ESP_{{ p2_encr |upper | replace("-", "") }}
 protocol esp encryption {{ p2_encr }}
 protocol esp integrity {{ p2_hash }}
!
crypto ipsec profile {{ cld_provider }}_ESP_{{ p2_encr |upper | replace("-", "") }}
 set ikev2 ipsec-proposal {{ cld_provider }}_ESP_{{ p2_encr |upper | replace("-", "") }}
 set pfs {{ pfs }}
 set security-association lifetime kilobytes {{ sa_size }}
 set security-association lifetime seconds {{ sa_life }}

{##### Tunnel interface, static route and Tunnel group  ######}
interface Tunnel1
 nameif {{ asa_tunnel_intf }}
 ip address {{ asa_tunnel_ip | ansible.utils.ipaddr('1') | ansible.utils.ipaddr('address') }} {{ asa_tunnel_ip | ansible.utils.ipaddr('netmask') }}
 tunnel source interface {{ asa_vpn_interface }}
 tunnel destination {{ hostvars.localhost.cld_public_ip }}
 tunnel mode ipsec ipv4
 tunnel protection ipsec profile {{ cld_provider }}_ESP_{{ p2_encr |upper | replace("-", "") }}
!
{% for rte in az_vn_addr_spc %}
route {{ asa_tunnel_intf }} {{ rte | ansible.utils.ipaddr('network') }} {{ rte | ansible.utils.ipaddr('netmask') }} {{ asa_tunnel_ip | ansible.utils.ipaddr('2') | ansible.utils.ipaddr('address') }} 1
{%endfor%}
!
tunnel-group {{ hostvars.localhost.cld_public_ip }} type ipsec-l2l
tunnel-group {{ hostvars.localhost.cld_public_ip }} ipsec-attributes
 ikev2 remote-authentication pre-shared-key {{ psk }}
 ikev2 local-authentication pre-shared-key {{ psk }}
